{
  "name": "dsh-chat-prune",
  "version": "0.4.5",
  "description": "DSH conversation management with retention previews, batch archive and pin actions, and guarded deletion.",
  "author": "Cans518",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cans518/dsh-chat-prune.git"
  },
  "homepage": "https://github.com/Cans518/dsh-chat-prune#readme",
  "bugs": {
    "url": "https://github.com/Cans518/dsh-chat-prune/issues"
  },
  "keywords": [
    "dsh",
    "dsh-next",
    "plugin",
    "chat",
    "conversation"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": "./client-slot.js"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check:build": "node test/client-fresh.mjs",
    "test": "node test/all.mjs",
    "test:installed": "node test/all.mjs --installed",
    "test:browser": "node scripts/build-client.mjs && node test/browser-e2e.mjs && node test/manager-e2e.mjs && node test/multi-source-e2e.mjs",
    "test:host": "node scripts/build-client.mjs && node test/host-e2e.mjs",
    "test:install": "npm run build && npm pack --ignore-scripts && node test/install-e2e.mjs",
    "prepack": "node scripts/build-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    },
    "manifestVersion": 1
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "license": "MIT",
  "icon": "./assets/icon.svg",
  "files": [
    "lib",
    "client.js",
    "client-core.js",
    "client-manager.js",
    "client-slot.js",
    "cordis.patch.yml",
    "assets",
    "docs",
    "LICENSE",
    "CONTRIBUTING.md",
    "README.md",
    "AUDIT.md"
  ],
  "devDependencies": {
    "playwright": "^1.61.0"
  }
}
